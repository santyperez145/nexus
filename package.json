{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p packages/sdk --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "tip-to-tip": "tsx scripts/tip-to-tip.ts",
    "catalog:build": "node scripts/build-catalog.mjs",
    "sdk:sync-models": "tsx scripts/sync-sdk-models.ts && npm run build --prefix packages/sdk",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs migrate",
    "db:baseline:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs baseline",
    "db:studio": "drizzle-kit studio",
    "stripe:configure": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/configure-stripe.mjs",
    "dev:gateway": "tsx services/gateway.ts",
    "dev:worker": "tsx services/worker.ts",
    "catalog:sync": "tsx services/worker.ts --once"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/mistral": "^4.0.65",
    "@ai-sdk/openai": "^4.0.95",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.142",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.58.0",
    "music-metadata": "^11.16.1",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "railway": "^3.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@4.23.13"
  }
}
