# Postgres / Neon. Vacío = PGlite en ./data/nexus
# DATABASE_URL=postgres://user:pass@localhost:5432/nexus

# Stripe — compra de créditos. Webhook: $NEXT_PUBLIC_APP_URL/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Wallet manual si Stripe aún no está (default: on). En prod: false
ENABLE_MANUAL_CREDITS=true

