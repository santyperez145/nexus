NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=cambia-esta-clave-de-32-chars-minimo
CREDENTIALS_SECRET=cambia-esta-clave-independiente-de-32-chars-minimo
# Allowlist explícita en todos los entornos; nunca se concede Superadmin por estar en desarrollo.
ADMIN_EMAILS=founder@example.com

# Postgres / Neon. Vacío = PGlite en ./data/nexus
# DATABASE_URL=postgres://user:pass@localhost:5432/nexus
# DATABASE_URL_UNPOOLED=postgres://user:pass@localhost:5432/nexus

# Stripe — créditos, suscripciones y portal. Webhook: $NEXT_PUBLIC_APP_URL/api/webhooks/stripe
# Prefer a Stripe restricted key with only the permissions used by Nexus (rk_...); sk_... also works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs recurrentes creados en Stripe Dashboard
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
# Habilitar solo después de configurar Tax Settings y registros fiscales en este entorno.
# STRIPE_AUTOMATIC_TAX_ENABLED=true

# Identidad por email. Ambas variables son obligatorias en producción.
# EMAIL_FROM debe ser un remitente verificado en Resend; el fallback sólo sirve en desarrollo.
RESEND_API_KEY=
EMAIL_FROM="Nexus <cuentas@tu-dominio.com>"

# Wallet sandbox (opt-in). Default: off. En prod no habilitar.
# ENABLE_MANUAL_CREDITS=true
# ENABLE_SIGNUP_BONUS=true
# ENABLE_GUEST_PLAYGROUND=true

# Solo demos efímeras sin Postgres. En prod Railway/Neon: no setear.
# ENABLE_PGLITE=true

# Pool de la plataforma (Settings → BYOK es aparte, por usuario)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
DEEPINFRA_API_KEY=
NOVITA_API_KEY=
NEBIUS_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
AI21_API_KEY=
HF_TOKEN=
REPLICATE_API_TOKEN=
LAMBDA_API_KEY=
SILICONFLOW_API_KEY=
FRIENDLI_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Confirmar sólo después de validar el acuerdo activo de cada cuenta de proveedor.
# IDs separados por comas, por ejemplo: azure,amazon,google-vertex
ZDR_PROVIDER_IDS=
NO_TRAINING_PROVIDER_IDS=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# Data plane opcional
# GATEWAY_URL=http://localhost:4001
# GATEWAY_PORT=4001
# WORKER_INTERVAL_MS=900000
# HEALTH_PROBE_INTERVAL_MS=900000
# WEBHOOK_RETRY_INTERVAL_MS=60000

# Redis / Upstash
# REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Orígenes extra para auth/cookies (coma-separados). /api/v1 ya es CORS abierto (Bearer).
# CORS_ORIGINS=https://app.tudominio.com
# CATALOG_FEED_URL=
# Secreto aleatorio de al menos 32 caracteres para crons internos.
CRON_SECRET=
# Required in production. Schedule GET /api/internal/cron/webhooks every 5 minutes.

# Búsqueda web (:online / nexus:web_search). Sin estas, DuckDuckGo.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Video
FAL_KEY=
# Obligatorio para habilitar video: tarifa minorista por trabajo, fijada por encima
# del peor costo upstream validado para los modelos permitidos.
NEXUS_VIDEO_RETAIL_USD=
